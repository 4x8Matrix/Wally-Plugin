				}
			},
			"Tests": {
				"$path": "Tests"
			}
		},
		"ServerScriptService": {
			"$properties": {
				"LoadStringEnabled": true
			},
			"RunTestsInStudio": {
				"$path": ".lune/test/bin/run-tests-in-studio.luau"
			}
		}
	}
}
